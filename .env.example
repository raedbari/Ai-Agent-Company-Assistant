APP_NAME=Travel-X Customer Agent
APP_ENV=development

OPENROUTER_API_KEY=replace_with_your_openrouter_key
OPENROUTER_MODEL=deepseek/deepseek-v4-flash
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_APP_URL=https://travel-x.online
OPENROUTER_APP_TITLE=Travel-X Customer Agent

# Keep tracing disabled until a LangSmith key is configured.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=replace_with_your_langsmith_key
LANGSMITH_PROJECT=travelx-customer-agent-dev
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_DATASET=travelx-semantic-regression-v1

# Safe defaults for real customer conversations.
# Use false only with synthetic development data when you need to inspect content.
LANGSMITH_HIDE_INPUTS=true
LANGSMITH_HIDE_OUTPUTS=true

# Curated Travel-X knowledge used by the RAG question-answering path.
KNOWLEDGE_FILE=knowledge/travelx_knowledge.json
KNOWLEDGE_TOP_K=4

# The fourth identical message requires verification; the sixth suspends the session.
EXACT_REPEAT_HUMAN_CHECK_THRESHOLD=3
EXACT_REPEAT_SUSPEND_THRESHOLD=5
SEMANTIC_REPEAT_HUMAN_CHECK_THRESHOLD=3
SEMANTIC_REPEAT_SUSPEND_THRESHOLD=5

SKILLS_FILE=skills/travelx_department_skills.json
DEPARTMENT_AGENT_TIMEOUT_SECONDS=20
DEPARTMENT_AGENT_MAX_ATTEMPTS=2